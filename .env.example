# 이 파일을 .env.local로 복사해서 값을 채운다. .env.local은 커밋하지 않는다.

# --- Neon Postgres ---
# 앱 런타임: RLS가 적용되는 app_user 역할. 풀링 연결(호스트에 -pooler)
DATABASE_URL=
# IGDB 가져오기 전용: catalog_writer 역할(카탈로그 테이블만 쓰기). 풀링 연결
DATABASE_URL_CATALOG=
# 마이그레이션·시드·역할 생성: 소유자 역할. 직접 연결(풀러를 거치지 않는다)이며 앱 런타임에서는 쓰지 않는다
DATABASE_URL_ADMIN=

# --- Neon Auth (feat/auth 단계에서 사용) ---
NEON_AUTH_BASE_URL=
# openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# --- IGDB (Twitch 앱, feat/games-search 단계에서 사용) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
